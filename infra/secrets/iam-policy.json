{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetVestingSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:vesting/*"
      ]
    },
    {
      "Sid": "ListVestingSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:ListSecrets"
      ],
      "Resource": ["*"]
    },
    {
      "Sid": "AuditLogDelivery",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:CreateTrail",
        "cloudtrail:PutEventSelectors",
        "cloudtrail:StartLogging"
      ],
      "Resource": ["*"]
    }
  ]
}
