{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens for Vesting Cliff Drip Stream — importable in Figma via the Tokens Studio plugin.",
  "color": {
    "$type": "color",
    "$description": "10-shade colour scales for primary, secondary, success, warning, error, and neutral.",
    "primary": {
      "50":  { "$value": "#F5F3FF", "$type": "color" },
      "100": { "$value": "#EDE9FE", "$type": "color" },
      "200": { "$value": "#DDD6FE", "$type": "color" },
      "300": { "$value": "#C4B5FD", "$type": "color" },
      "400": { "$value": "#A78BFA", "$type": "color" },
      "500": { "$value": "#8B5CF6", "$type": "color" },
      "600": { "$value": "#7C3AED", "$type": "color", "$description": "violet-600 — brand primary" },
      "700": { "$value": "#6D28D9", "$type": "color" },
      "800": { "$value": "#5B21B6", "$type": "color" },
      "900": { "$value": "#4C1D95", "$type": "color" }
    },
    "secondary": {
      "50":  { "$value": "#EEF2FF", "$type": "color" },
      "100": { "$value": "#E0E7FF", "$type": "color" },
      "200": { "$value": "#C7D2FE", "$type": "color" },
      "300": { "$value": "#A5B4FC", "$type": "color" },
      "400": { "$value": "#818CF8", "$type": "color" },
      "500": { "$value": "#6366F1", "$type": "color" },
      "600": { "$value": "#4F46E5", "$type": "color", "$description": "indigo-600 — brand secondary" },
      "700": { "$value": "#4338CA", "$type": "color" },
      "800": { "$value": "#3730A3", "$type": "color" },
      "900": { "$value": "#312E81", "$type": "color" }
    },
    "success": {
      "50":  { "$value": "#ECFDF5", "$type": "color" },
      "100": { "$value": "#D1FAE5", "$type": "color" },
      "200": { "$value": "#A7F3D0", "$type": "color" },
      "300": { "$value": "#6EE7B7", "$type": "color" },
      "400": { "$value": "#34D399", "$type": "color" },
      "500": { "$value": "#10B981", "$type": "color", "$description": "emerald-500" },
      "600": { "$value": "#059669", "$type": "color" },
      "700": { "$value": "#047857", "$type": "color" },
      "800": { "$value": "#065F46", "$type": "color" },
      "900": { "$value": "#064E3B", "$type": "color" }
    },
    "warning": {
      "50":  { "$value": "#FFFBEB", "$type": "color" },
      "100": { "$value": "#FEF3C7", "$type": "color" },
      "200": { "$value": "#FDE68A", "$type": "color" },
      "300": { "$value": "#FCD34D", "$type": "color" },
      "400": { "$value": "#FBBF24", "$type": "color" },
      "500": { "$value": "#F59E0B", "$type": "color", "$description": "amber-500" },
      "600": { "$value": "#D97706", "$type": "color" },
      "700": { "$value": "#B45309", "$type": "color" },
      "800": { "$value": "#92400E", "$type": "color" },
      "900": { "$value": "#78350F", "$type": "color" }
    },
    "error": {
      "50":  { "$value": "#FEF2F2", "$type": "color" },
      "100": { "$value": "#FEE2E2", "$type": "color" },
      "200": { "$value": "#FECACA", "$type": "color" },
      "300": { "$value": "#FCA5A5", "$type": "color" },
      "400": { "$value": "#F87171", "$type": "color" },
      "500": { "$value": "#EF4444", "$type": "color", "$description": "red-500" },
      "600": { "$value": "#DC2626", "$type": "color" },
      "700": { "$value": "#B91C1C", "$type": "color" },
      "800": { "$value": "#991B1B", "$type": "color" },
      "900": { "$value": "#7F1D1D", "$type": "color" }
    },
    "neutral": {
      "50":  { "$value": "#F8FAFC", "$type": "color" },
      "100": { "$value": "#F1F5F9", "$type": "color" },
      "200": { "$value": "#E2E8F0", "$type": "color" },
      "300": { "$value": "#CBD5E1", "$type": "color" },
      "400": { "$value": "#94A3B8", "$type": "color" },
      "500": { "$value": "#64748B", "$type": "color" },
      "600": { "$value": "#475569", "$type": "color" },
      "700": { "$value": "#334155", "$type": "color" },
      "800": { "$value": "#1E293B", "$type": "color" },
      "900": { "$value": "#0F172A", "$type": "color" }
    },
    "semantic": {
      "$description": "Semantic colour aliases. These point to palette shades and flip between dark (default) and light themes.",
      "brand-primary":    { "$value": "{color.primary.600}",   "$type": "color", "$description": "Primary actions, focus rings" },
      "brand-secondary":  { "$value": "{color.secondary.600}", "$type": "color", "$description": "Hover states" },
      "accent":           { "$value": "#06B6D4",               "$type": "color", "$description": "cyan-500 — highlights" },
      "success":          { "$value": "{color.success.500}",   "$type": "color" },
      "warning":          { "$value": "{color.warning.500}",   "$type": "color" },
      "danger":           { "$value": "{color.error.500}",     "$type": "color" }
    },
    "dark": {
      "$description": "Dark theme (default) semantic surface/text/border aliases.",
      "bg-base":          { "$value": "{color.neutral.900}", "$type": "color" },
      "bg-surface":       { "$value": "{color.neutral.800}", "$type": "color" },
      "bg-elevated":      { "$value": "{color.neutral.700}", "$type": "color" },
      "text-primary":     { "$value": "{color.neutral.50}",  "$type": "color" },
      "text-secondary":   { "$value": "{color.neutral.400}", "$type": "color" },
      "text-disabled":    { "$value": "{color.neutral.600}", "$type": "color" },
      "border":           { "$value": "{color.neutral.700}", "$type": "color" },
      "border-focus":     { "$value": "{color.primary.600}", "$type": "color" }
    },
    "light": {
      "$description": "Light theme semantic surface/text/border aliases (data-theme='light').",
      "bg-base":          { "$value": "{color.neutral.50}",  "$type": "color" },
      "bg-surface":       { "$value": "#FFFFFF",             "$type": "color" },
      "bg-elevated":      { "$value": "{color.neutral.100}", "$type": "color" },
      "text-primary":     { "$value": "{color.neutral.900}", "$type": "color" },
      "text-secondary":   { "$value": "{color.neutral.600}", "$type": "color" },
      "text-disabled":    { "$value": "{color.neutral.400}", "$type": "color" },
      "border":           { "$value": "{color.neutral.200}", "$type": "color" },
      "border-focus":     { "$value": "{color.primary.600}", "$type": "color" }
    }
  },
  "typography": {
    "$description": "Font families, fluid type scale, weights, and line heights.",
    "fontFamily": {
      "base": { "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', 'Menlo', monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "$description": "Fluid type scale using clamp() — interpolates from 320px to 1280px viewport.",
      "xs":   { "$value": "clamp(0.6875rem, 0.6583rem + 0.1458vw, 0.75rem)",   "$type": "dimension", "$description": "11px → 12px — labels, captions" },
      "sm":   { "$value": "clamp(0.8125rem, 0.7833rem + 0.1458vw, 0.875rem)",  "$type": "dimension", "$description": "13px → 14px — secondary text, badges" },
      "base": { "$value": "clamp(1rem, 0.9292rem + 0.3542vw, 1.125rem)",       "$type": "dimension", "$description": "16px → 18px — body text" },
      "lg":   { "$value": "clamp(1.125rem, 1.0542rem + 0.3542vw, 1.25rem)",    "$type": "dimension", "$description": "18px → 20px — sub-headings, card titles" },
      "xl":   { "$value": "clamp(1.25rem, 1.1083rem + 0.7083vw, 1.5rem)",      "$type": "dimension", "$description": "20px → 24px — section headings h4" },
      "2xl":  { "$value": "clamp(1.5rem, 1.2875rem + 1.0625vw, 1.875rem)",     "$type": "dimension", "$description": "24px → 30px — page sub-headings h3" },
      "3xl":  { "$value": "clamp(1.875rem, 1.5917rem + 1.4167vw, 2.375rem)",   "$type": "dimension", "$description": "30px → 38px — page headings h2" },
      "4xl":  { "$value": "clamp(2.25rem, 1.8250rem + 2.125vw, 3rem)",         "$type": "dimension", "$description": "36px → 48px — hero / display h1" }
    },
    "fontWeight": {
      "normal":    { "$value": 400, "$type": "fontWeight" },
      "medium":    { "$value": 500, "$type": "fontWeight" },
      "semibold":  { "$value": 600, "$type": "fontWeight" },
      "bold":      { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    },
    "lineHeight": {
      "none":    { "$value": 1,     "$type": "number", "$description": "Single-line labels" },
      "tight":   { "$value": 1.25,  "$type": "number", "$description": "Headings" },
      "snug":    { "$value": 1.375, "$type": "number", "$description": "Sub-headings" },
      "body":    { "$value": 1.6,   "$type": "number", "$description": "Body text" },
      "relaxed": { "$value": 1.75,  "$type": "number", "$description": "Long-form prose" }
    },
    "letterSpacing": {
      "tight":  { "$value": "-0.025em", "$type": "dimension", "$description": "Large headings" },
      "normal": { "$value": "0",        "$type": "dimension" },
      "wide":   { "$value": "0.025em",  "$type": "dimension", "$description": "ALL-CAPS labels" },
      "wider":  { "$value": "0.05em",   "$type": "dimension", "$description": "Monospace addresses" }
    }
  },
  "spacing": {
    "$description": "4-point grid spacing scale.",
    "$type": "dimension",
    "1":  { "$value": "0.25rem",  "$description": "4px" },
    "2":  { "$value": "0.5rem",   "$description": "8px" },
    "3":  { "$value": "0.75rem",  "$description": "12px" },
    "4":  { "$value": "1rem",     "$description": "16px" },
    "5":  { "$value": "1.25rem",  "$description": "20px" },
    "6":  { "$value": "1.5rem",   "$description": "24px" },
    "8":  { "$value": "2rem",     "$description": "32px" },
    "10": { "$value": "2.5rem",   "$description": "40px" },
    "12": { "$value": "3rem",     "$description": "48px" },
    "16": { "$value": "4rem",     "$description": "64px" }
  },
  "borderRadius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "sm":   { "$value": "0.25rem" },
    "base": { "$value": "0.5rem" },
    "lg":   { "$value": "0.75rem" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "$description": "Elevation shadows. Dark theme uses higher opacity; light theme uses lower opacity.",
    "dark": {
      "sm": { "$value": "0 1px 2px 0 rgba(0,0,0,0.4)",                                                                    "$type": "shadow" },
      "md": { "$value": "0 4px 6px -1px rgba(0,0,0,0.4), 0 2px 4px -2px rgba(0,0,0,0.4)",                                "$type": "shadow" },
      "lg": { "$value": "0 10px 15px -3px rgba(0,0,0,0.5), 0 4px 6px -4px rgba(0,0,0,0.4)",                              "$type": "shadow" },
      "xl": { "$value": "0 20px 25px -5px rgba(0,0,0,0.5), 0 8px 10px -6px rgba(0,0,0,0.5)",                             "$type": "shadow" }
    },
    "light": {
      "sm": { "$value": "0 1px 2px 0 rgba(15,23,42,0.06)",                                                                "$type": "shadow" },
      "md": { "$value": "0 4px 6px -1px rgba(15,23,42,0.08), 0 2px 4px -2px rgba(15,23,42,0.06)",                        "$type": "shadow" },
      "lg": { "$value": "0 10px 15px -3px rgba(15,23,42,0.1), 0 4px 6px -4px rgba(15,23,42,0.06)",                       "$type": "shadow" },
      "xl": { "$value": "0 20px 25px -5px rgba(15,23,42,0.12), 0 8px 10px -6px rgba(15,23,42,0.08)",                     "$type": "shadow" }
    }
  },
  "animation": {
    "$description": "Duration and easing curves for transitions.",
    "duration": {
      "fast":   { "$value": "150ms", "$type": "duration" },
      "base":   { "$value": "250ms", "$type": "duration" },
      "slow":   { "$value": "400ms", "$type": "duration" }
    },
    "easing": {
      "default":    { "$value": "ease",          "$type": "cubicBezier" },
      "in":         { "$value": "ease-in",       "$type": "cubicBezier" },
      "out":        { "$value": "ease-out",      "$type": "cubicBezier" },
      "in-out":     { "$value": "ease-in-out",   "$type": "cubicBezier" },
      "spring":     { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "Playful spring for interactive feedback" }
    }
  }
}
