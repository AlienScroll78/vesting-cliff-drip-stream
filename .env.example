# ──────────────────────────────────────────────────────────────────────────────
# Vesting Cliff Drip Stream — Backend Environment Variables
# Copy this file to .env and fill in the values for your environment.
# See docs/config.md for full descriptions, valid values, and security notes.
# ──────────────────────────────────────────────────────────────────────────────
#
# ── ESO-Managed Variables ────────────────────────────────────────────────────
# When deployed via Helm with externalSecret.enabled=true (default), these
# variables are injected from the ExternalSecret Operator and must NOT be
# set in ConfigMap or hardcoded:
#
#   DATABASE_URL          — PostgreSQL connection string
#   REDIS_URL             — Redis connection string
#   ADMIN_API_KEY         — Bearer token for admin endpoints
#   SPONSOR_SECRET_KEY    — Stellar secret key for signing claims
#   SIGNING_SECRET_KEY    — Service keypair for tx submission
#   JWT_SECRET            — JWT signing key (min 32 chars)
#   WEBHOOK_SECRET        — HMAC-SHA256 webhook signing secret
#   HORIZON_API_KEY       — Horizon REST API key (if authenticated)
#
# For local development without ESO, set them in your local .env.
# ──────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────

# HTTP server port (default: 3000)
# PORT=3000

# Deployment environment: development | test | staging | production (default: development)
# NODE_ENV=development

# Enable CORS for all origins — set to true in development only, NEVER in production
# CORS_ALL_ORIGINS=false


# ── Stellar / Horizon ─────────────────────────────────────────────────────────

# Horizon REST API endpoint [REQUIRED]
HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar network passphrase — must match the network the contract is deployed on [REQUIRED]
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC endpoint for transaction simulation and submission [REQUIRED]
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Webhook system ────────────────────────────────────────────────────────────

# Maximum number of webhooks a single sponsor may register (default: 10)
# WEBHOOK_MAX_PER_SPONSOR=10

# Log verbosity: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Pretty-print logs in development (default: false — outputs JSON in production)
# LOG_PRETTY=true

# Service name and version stamped on every log line
# SERVICE_NAME=vesting-backend
# SERVICE_VERSION=1.0.0

# Soroban RPC response timeout in milliseconds (default: 30000)
# REQUEST_TIMEOUT_MS=30000

# Network label used by scripts: testnet | mainnet | standalone (default: testnet)
# STELLAR_NETWORK=testnet

# Optional Horizon REST API key for authenticated requests (injected by ESO in production)
# HORIZON_API_KEY=


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# NOTE: In production DATABASE_URL is injected by ESO. Set here for local dev.
# DATABASE_URL=postgres://vesting:vesting@localhost:5432/vesting

# Maximum number of pooled PostgreSQL connections (default: 10)
# DB_POOL_MAX=10


# ── Redis ─────────────────────────────────────────────────────────────────────
# NOTE: In production REDIS_URL is injected by ESO. Set here for local dev.
# Required for: rate limiting, auth nonces, view-function caching, export rate limits.
# REDIS_URL=redis://localhost:6379

# Default TTL for cached entries in seconds (default: 300)
# REDIS_TTL_SECONDS=300


# ── Authentication & JWT ──────────────────────────────────────────────────────
# NOTE: In production JWT_SECRET is injected by ESO.
# Must be at least 32 characters. Generate with: openssl rand -base64 32
# JWT_SECRET=

# JWT expiry as a vercel/ms duration string (default: 1h)
# JWT_EXPIRES_IN=1h

# Maximum age (ms) of a Stellar signature in the auth challenge flow (default: 300000 = 5 min)
# AUTH_SIGNATURE_WINDOW_MS=300000


# ── Rate Limiting ─────────────────────────────────────────────────────────────

# Max requests per IP per window (default: 100)
# RATE_LIMIT_IP_MAX=100

# Max requests per API key per window (default: 1000)
# RATE_LIMIT_KEY_MAX=1000

# Sliding window size in seconds (default: 60)
# RATE_LIMIT_WINDOW_SEC=60

# Comma-separated IPs to bypass rate limiting (e.g. internal health-check IPs)
# RATE_LIMIT_BYPASS_IPS=

# Comma-separated API keys to bypass rate limiting
# RATE_LIMIT_BYPASS_KEYS=


# ── Webhooks ──────────────────────────────────────────────────────────────────
# NOTE: In production WEBHOOK_SECRET is injected by ESO.
# Must be at least 16 characters. Generate with: openssl rand -base64 24
# WEBHOOK_SECRET=

# Comma-separated list of allowed webhook destination URLs. Empty = disabled.
# WEBHOOK_ALLOWED_URLS=


# ── OpenTelemetry ─────────────────────────────────────────────────────────────

# OTLP HTTP endpoint for trace export. Empty = tracing disabled. (default: "")
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logical service name in traces (default: vesting-backend)
# OTEL_SERVICE_NAME=vesting-backend

# Service version in traces — set to image tag in CI/CD (default: 0.0.0)
# OTEL_SERVICE_VERSION=0.0.0

# Tail-sampling rate 0.0–1.0 (default: 0.1 = 10%). Use 1.0 locally for full traces.
# OTEL_SAMPLE_RATE=0.1


# ── Logging ───────────────────────────────────────────────────────────────────

# Log verbosity: trace | debug | info | warn | error | fatal (default: info)
# LOG_LEVEL=info


# ── Admin / Bulk Claim ────────────────────────────────────────────────────────
# NOTE: In production these are injected by ESO. Set here for local dev only.

# Bearer token for POST /admin/bulk-claim (use a strong random secret, ≥32 chars)
# ADMIN_API_KEY=

# Stellar secret key (S...) of the account that signs claim transactions
# SPONSOR_SECRET_KEY=

# Service keypair secret key for automated POST /tx/submit transaction signing
# SIGNING_SECRET_KEY=


# ── GraphQL ───────────────────────────────────────────────────────────────────

# Maximum GraphQL query depth (default: 5)
# GRAPHQL_MAX_DEPTH=5
