# ──────────────────────────────────────────────────────────────────────────────
# Vesting Cliff Drip Stream — Backend Environment Variables
# Copy this file to .env and fill in the values for your environment.
# See docs/config.md for full descriptions and accepted values.
# ──────────────────────────────────────────────────────────────────────────────
#
# ── ESO-Managed Variables ────────────────────────────────────────────────────
# When deployed via Helm with externalSecret.enabled=true (default), these
# variables are injected from the ExternalSecret Operator and should not be
# set in this file or in ConfigMap:
#
#   DATABASE_URL          — PostgreSQL connection string
#   REDIS_URL             — Redis connection string
#   ADMIN_API_KEY         — Bearer token for admin endpoints
#   SPONSOR_SECRET_KEY    — Stellar secret key for signing claims
#   JWT_SECRET            — JWT signing key
#   HORIZON_API_KEY       — Horizon REST API key
#
# For local development without ESO, set them in your local .env.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Horizon REST API endpoint
HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar network passphrase (must match the network the contract is deployed on)
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban contract ID of the deployed vesting_cliff_drip_stream contract
CONTRACT_ID=

# ── Required for POST /admin/bulk-claim ───────────────────────────────────────

# NOTE: In production these are injected by ESO. Set them here for local dev.
# Bearer token for admin endpoint authentication (use a strong random secret)
ADMIN_API_KEY=

# Stellar secret key (S...) of the account that signs claim transactions
SPONSOR_SECRET_KEY=

# Soroban RPC endpoint for transaction submission
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Required for POST /tx/submit ──────────────────────────────────────────────

# Service keypair for automated tx submission (never commit this value)
# SIGNING_SECRET_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# HTTP server port (default: 3000)
# PORT=3000

# ── Webhook system ────────────────────────────────────────────────────────────

# Maximum number of webhooks a single sponsor may register (default: 10)
# WEBHOOK_MAX_PER_SPONSOR=10

# Log verbosity: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Pretty-print logs in development (default: false — outputs JSON in production)
# LOG_PRETTY=true

# Service name and version stamped on every log line
# SERVICE_NAME=vesting-backend
# SERVICE_VERSION=1.0.0

# Soroban RPC response timeout in milliseconds (default: 30000)
# REQUEST_TIMEOUT_MS=30000

# GraphQL depth limit (default: 5)
# GRAPHQL_MAX_DEPTH=5

# OpenTelemetry — traces exported to OTLP HTTP (Jaeger on localhost by default)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SERVICE_NAME=vesting-backend
# SERVICE_VERSION=0.0.0

# ── PostgreSQL (#33) ──────────────────────────────────────────────────────────
# NOTE: In production DATABASE_URL is injected by ESO.
# DATABASE_URL=postgres://user:pass@localhost:5432/vesting

# ── Redis – rate limiting + analytics cache (#32, #34) ───────────────────────
# NOTE: In production REDIS_URL is injected by ESO.
# REDIS_URL=redis://localhost:6379

# ── JWT secret for token signing ──────────────────────────────────────────────
# NOTE: In production JWT_SECRET is injected by ESO.
# JWT_SECRET=

# ── Horizon API key (optional, for authenticated Horizon requests) ──────────
# NOTE: In production HORIZON_API_KEY is injected by ESO.
# HORIZON_API_KEY=

# ── Rate limiting (#32) ───────────────────────────────────────────────────────
# RATE_LIMIT_IP_MAX=100          # max requests per IP per window (default 100)
# RATE_LIMIT_KEY_MAX=1000        # max requests per API key per window (default 1000)
# RATE_LIMIT_WINDOW_SEC=60       # window size in seconds (default 60)
# RATE_LIMIT_BYPASS_IPS=         # comma-separated IPs to bypass
# RATE_LIMIT_BYPASS_KEYS=        # comma-separated API keys to bypass
