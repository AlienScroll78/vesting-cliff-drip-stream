# ─────────────────────────────────────────────────────────────────────────────
# Vesting Cliff Drip Stream – Backend Environment Variables
# Copy this file to .env and fill in all required values before starting the
# server. Lines marked "required" have no default and MUST be set; the
# application will exit immediately with an error if they are missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────

# TCP port the HTTP server listens on.
# default: 3000
PORT=3000

# Deployment environment. One of: development | test | staging | production
# default: development
NODE_ENV=development

# ── Stellar / Horizon ─────────────────────────────────────────────────────────

# Base URL of the Horizon instance used for submitting transactions. (required)
HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar network passphrase. (required)
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed vesting contract address (C... Strkey). (required)
VESTING_CONTRACT_ID=

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection URL. (required)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vesting

# Maximum number of pooled database connections.
# default: 10
DB_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────────────────────

# Redis connection URL. (required)
# Format: redis://[:password@]host[:port][/db]
REDIS_URL=redis://localhost:6379

# Default TTL for cached entries in seconds.
# default: 300
REDIS_TTL_SECONDS=300

# ── Webhooks ──────────────────────────────────────────────────────────────────

# Shared secret used to sign outgoing webhook payloads (HMAC-SHA256). (required)
# Must be at least 16 characters.
WEBHOOK_SECRET=change-me-in-production

# Comma-separated list of allowed webhook destination URLs.
# default: (empty – no webhooks sent)
WEBHOOK_ALLOWED_URLS=

# ── OpenTelemetry ─────────────────────────────────────────────────────────────

# OTLP endpoint for trace export. Leave empty to disable tracing.
# default: (empty – disabled)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Logical service name reported in traces.
# default: vesting-backend
OTEL_SERVICE_NAME=vesting-backend

# Service version reported in traces.
# default: 0.0.0
OTEL_SERVICE_VERSION=0.0.0

# Tail-sampling rate as a fraction between 0 and 1.
# 0.1 = sample 10 % of traces (recommended for production).
# default: 0.1
OTEL_SAMPLE_RATE=0.1

# ── Auth / Security ───────────────────────────────────────────────────────────

# Secret used to sign JWT access tokens. (required)
# Must be at least 32 characters. Use a strong random value in production.
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars

# JWT expiry expressed as a vercel/ms duration string.
# default: 1h
JWT_EXPIRES_IN=1h

# Enable CORS for all origins. Set to "true" only in local development.
# default: false
CORS_ALL_ORIGINS=false

# ── Logging ───────────────────────────────────────────────────────────────────

# Minimum log level. One of: trace | debug | info | warn | error | fatal
# default: info
LOG_LEVEL=info
