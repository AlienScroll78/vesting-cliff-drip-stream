# ──────────────────────────────────────────────────────────────────────────────
# Vesting Cliff Drip Stream — Backend Environment Variables
# Copy this file to .env and fill in the values for your environment.
# See docs/config.md for full descriptions, valid values, and security notes.
# ──────────────────────────────────────────────────────────────────────────────
#
# ── ESO-Managed Variables ────────────────────────────────────────────────────
# When deployed via Helm with externalSecret.enabled=true (default), these
# variables are injected from the ExternalSecret Operator and must NOT be
# set in ConfigMap or hardcoded:
#
#   DATABASE_URL          — PostgreSQL connection string
#   REDIS_URL             — Redis connection string
#   ADMIN_API_KEY         — Bearer token for admin endpoints
#   SPONSOR_SECRET_KEY    — Stellar secret key for signing claims
#   SIGNING_SECRET_KEY    — Service keypair for tx submission
#   JWT_SECRET            — JWT signing key (min 32 chars)
#   WEBHOOK_SECRET        — HMAC-SHA256 webhook signing secret
#   HORIZON_API_KEY       — Horizon REST API key (if authenticated)
#
# For local development without ESO, set them in your local .env.
# ──────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────

# HTTP server port (default: 3000)
# PORT=3000

# Deployment environment: development | test | staging | production (default: development)
# NODE_ENV=development

# Enable CORS for all origins — set to true in development only, NEVER in production
# CORS_ALL_ORIGINS=false


# ── Stellar / Horizon ─────────────────────────────────────────────────────────

# Horizon REST API endpoint [REQUIRED]
HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar network passphrase — must match the network the contract is deployed on [REQUIRED]
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC endpoint for transaction simulation and submission [REQUIRED]
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Webhook system ────────────────────────────────────────────────────────────

# Maximum number of webhooks a single sponsor may register (default: 10)
# WEBHOOK_MAX_PER_SPONSOR=10

# Log verbosity: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Pretty-print logs in development (default: false — outputs JSON in production)
# LOG_PRETTY=true

# Service name and version stamped on every log line
# SERVICE_NAME=vesting-backend
# SERVICE_VERSION=1.0.0

# Soroban RPC response timeout in milliseconds (default: 30000)
# REQUEST_TIMEOUT_MS=30000

# Network label used by scripts: testnet | mainnet | standalone (default: testnet)
# STELLAR_NETWORK=testnet

# Optional Horizon REST API key for authenticated requests (injected by ESO in production)
# HORIZON_API_KEY=


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# NOTE: In production DATABASE_URL is injected by ESO. Set here for local dev.
# DATABASE_URL=postgres://vesting:vesting@localhost:5432/vesting

# Maximum number of pooled PostgreSQL connections (default: 10)
# DB_POOL_MAX=10


# ── Redis ─────────────────────────────────────────────────────────────────────
# NOTE: In production REDIS_URL is injected by ESO. Set here for local dev.
# Required for: rate limiting, auth nonces, view-function caching, export rate limits.
# REDIS_URL=redis://localhost:6379

# ── Rate limiting (#32) ───────────────────────────────────────────────────────
# RATE_LIMIT_IP_MAX=100          # max requests per IP per window (default 100)
# RATE_LIMIT_KEY_MAX=1000        # max requests per API key per window (default 1000)
# RATE_LIMIT_WINDOW_SEC=60       # window size in seconds (default 60)
# RATE_LIMIT_BYPASS_IPS=         # comma-separated IPs to bypass
# RATE_LIMIT_BYPASS_KEYS=        # comma-separated API keys to bypass

# ── JWT Auth v2 — RS256 (#742) ────────────────────────────────────────────────
# Comma-separated list of Stellar addresses granted the 'admin' role in JWTs.
# ADMIN_ADDRESSES=GABC...,GDEF...

# Access token time-to-live in hours (default: 24)
# AUTH_ACCESS_TOKEN_TTL_H=24

# Refresh token time-to-live in days (default: 30)
# AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Optionally provide persistent RSA key pair (PEM). If absent, an ephemeral key
# pair is generated at startup — not suitable for multi-instance deployments.
# Generate with:
#   openssl genrsa -out signing.pem 2048
#   openssl rsa -in signing.pem -pubout -out signing.pub.pem
# Then set:
# SIGNING_PRIVATE_KEY_PEM=<contents of signing.pem>
# SIGNING_PUBLIC_KEY_PEM=<contents of signing.pub.pem>
