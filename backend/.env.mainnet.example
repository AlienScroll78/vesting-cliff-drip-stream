# ──────────────────────────────────────────────────────────────────────────────
# Backend environment — STELLAR MAINNET (public)
#
# ⚠️ REFERENCE TEMPLATE — DO NOT USE AS A LOCAL .env
#
# This file documents the production values. In staging and production every
# secret below (DATABASE_URL, REDIS_URL, JWT_SECRET, WEBHOOK_SECRET,
# ADMIN_API_KEY, SPONSOR_SECRET_KEY) is injected by External Secrets Operator
# from AWS Secrets Manager. They are placeholders here on purpose — never commit
# real values, and never copy this file to a developer machine.
#
# See docs/deployment-environments.md for the full testnet/mainnet comparison
# and the mainnet pre-flight checklist.
# See docs/config.md for every variable and its validation rules.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# PORT is set per-environment in the Helm chart, not here.
NODE_ENV=production

# Never true in production — the frontend and API share an origin behind the
# ingress, so CORS is not needed.
CORS_ALL_ORIGINS=false

# ── Stellar / Horizon — MAINNET ──────────────────────────────────────────────
HORIZON_URL=https://horizon.stellar.org
NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
SOROBAN_RPC_URL=https://soroban.stellar.org

# Network label used by scripts: testnet | public | standalone
STELLAR_NETWORK=public

# Mainnet contract ID — must NOT be the testnet ID. Confirm before every deploy:
#   stellar contract info --id <ID> --network public
# Updated per release; record superseded IDs in the release notes.
VESTING_CONTRACT_ID=<MAINNET_CONTRACT_ID>

# ── Secrets — injected by ESO, placeholders only ─────────────────────────────
DATABASE_URL=<injected-by-external-secrets-operator>
REDIS_URL=<injected-by-external-secrets-operator>
JWT_SECRET=<injected-by-external-secrets-operator>
WEBHOOK_SECRET=<injected-by-external-secrets-operator>
ADMIN_API_KEY=<injected-by-external-secrets-operator>
SPONSOR_SECRET_KEY=<injected-by-external-secrets-operator>

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Keep DB_POOL_MAX x task count within the RDS max_connections headroom.
DB_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_TTL_SECONDS=300

# ── Authentication ───────────────────────────────────────────────────────────
JWT_EXPIRES_IN=1h
AUTH_SIGNATURE_WINDOW_MS=300000

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_MAX_PER_SPONSOR=10

# ── Rate limiting ────────────────────────────────────────────────────────────
# Mainnet traffic warrants tighter limits than the testnet defaults.
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_KEY_MAX=1000
RATE_LIMIT_WINDOW_SEC=60

# ── Logging ──────────────────────────────────────────────────────────────────
# JSON output, no pretty-printing in production.
LOG_LEVEL=info
LOG_PRETTY=false
SERVICE_NAME=vesting-backend

# ── HTTP client ──────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000

# ──────────────────────────────────────────────────────────────────────────────
# Account funding: there is NO mainnet faucet. Every account must be funded
# manually by transferring XLM to its public key. Friendbot is testnet-only.
#
# Fees: the base fee is dynamic on mainnet. Read it from getLatestLedger and add
# a priority tip; do not hardcode the testnet 100-stroop value.
# ──────────────────────────────────────────────────────────────────────────────
