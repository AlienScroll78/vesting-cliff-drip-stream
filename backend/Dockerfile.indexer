# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# backend/Dockerfile.indexer
#
# Multi-stage build for the vesting-drips event indexer service.
#
# The indexer is a long-running Node process that polls the Horizon API for
# Soroban contract events and writes them to PostgreSQL.
#
# Stages:
#   deps     — install production + dev dependencies (layer-cached)
#   build    — compile TypeScript to dist/
#   prod     — minimal runtime image (no source, no dev deps, non-root)
#
# Image size target: < 150 MB
# Non-root user: node (uid 1000)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Install all dependencies ────────────────────────────────────────
FROM node:22.11.0-alpine3.20 AS deps

RUN apk add --no-cache python3 make g++

WORKDIR /app

# Dependency manifests first — cached unless package files change.
COPY package.json package-lock.json ./

RUN npm ci --ignore-scripts

# ── Stage 2: Compile TypeScript ───────────────────────────────────────────────
FROM deps AS build

COPY tsconfig.json ./
COPY src ./src

RUN npx tsc --project tsconfig.json

# ── Stage 3: Production image ─────────────────────────────────────────────────
FROM node:22.11.0-alpine3.20 AS prod

ARG BUILD_DATE
ARG GIT_REVISION
ARG VERSION

LABEL org.opencontainers.image.title="vesting-drips-indexer" \
      org.opencontainers.image.description="Vesting Cliff Drip Stream event indexer service" \
      org.opencontainers.image.source="https://github.com/AlienScroll78/vesting-cliff-drip-stream" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="MIT"

# curl for healthcheck; tini for proper signal handling
RUN apk add --no-cache curl tini

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Copy compiled output only — no TypeScript source, no test fixtures
COPY --from=build /app/dist ./dist

# The indexer does not run migrations; no need to copy the migrations directory.

USER node

ENV NODE_ENV=production \
    INDEXER_PORT=9464

EXPOSE 9464

# Liveness: the indexer exposes a Prometheus metrics endpoint that doubles as
# a health probe (it returns 200 when the poll loop is running).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -sf http://localhost:9464/metrics || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/src/indexer/index.js"]
