{
  "name": "vesting-cliff-drip-stream-backend",
  "version": "1.0.0",
  "description": "Backend indexer / API for the Vesting Cliff Drip Stream dApp",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:migrations": "jest --testPathPattern='tests/migrations' --runInBand --forceExit",
    "test:coverage": "jest --coverage",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create"
  },
  "dependencies": {
    "pg": "8.13.3",
    "node-pg-migrate": "7.9.1",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/pg": "8.11.11",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "globalSetup": "./tests/setup.ts",
    "globalTeardown": "./tests/teardown.ts",
    "testTimeout": 30000
  }
}
