# ──────────────────────────────────────────────────────────────────────────────
# Backend environment — STELLAR TESTNET
# Copy to backend/.env and fill in the placeholders.
# See docs/deployment-environments.md for the full testnet/mainnet comparison.
# See docs/config.md for every variable and its validation rules.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Enable CORS for all origins — development only, NEVER in production
CORS_ALL_ORIGINS=true

# ── Stellar / Horizon — TESTNET ───────────────────────────────────────────────
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network label used by scripts: testnet | public | standalone
STELLAR_NETWORK=testnet

# Testnet contract ID — NOT the mainnet one. Get it from:
#   gh variable get VESTING_CONTRACT
VESTING_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ── PostgreSQL (local dev only; injected by ESO in staging/production) ────────
DATABASE_URL=postgres://vesting:vesting@localhost:5432/vesting
DB_POOL_MAX=10

# ── Redis (local dev only) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=300

# ── Authentication (local dev only) ──────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_SECRET=dev-only-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
AUTH_SIGNATURE_WINDOW_MS=300000

ADMIN_API_KEY=dev-admin-key

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=dev-only-webhook-secret-16chars
WEBHOOK_MAX_PER_SPONSOR=10

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_KEY_MAX=1000
RATE_LIMIT_WINDOW_SEC=60

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true
SERVICE_NAME=vesting-backend
SERVICE_VERSION=0.0.0-dev

# ── HTTP client ──────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000

# ──────────────────────────────────────────────────────────────────────────────
# Funding testnet accounts: https://friendbot.stellar.org?addr=<PUBLIC_KEY>
# Friendbot is testnet-only and has no mainnet equivalent.
# ──────────────────────────────────────────────────────────────────────────────
